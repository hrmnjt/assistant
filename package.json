{
  "name": "assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/run.mjs build",
    "check": "npm run build && node scripts/cloudflare.mjs check",
    "test": "node scripts/run.mjs test && node scripts/cloudflare.mjs test",
    "test:ui": "node scripts/browser.mjs test",
    "test:ui:install": "node scripts/browser.mjs install chromium webkit",
    "test:browser": "npm run build && node scripts/browser.mjs test --config tests/browser/playwright.config.ts",
    "deploy": "npm run build && node scripts/cloudflare.mjs deploy",
    "wrangler": "node scripts/cloudflare.mjs wrangler"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "ical.js": "2.2.1",
    "lucide-react": "1.56.0",
    "luxon": "3.7.2",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tsdav": "2.4.0",
    "vaul": "1.1.2",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
