{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "household-assistant-prototype",
  "main": "worker.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "HOUSEHOLD", "class_name": "HouseholdPrototype" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HouseholdPrototype"] }],
  "observability": { "enabled": false },
  "vars": { "MODEL_MODE": "fixture" },
}
