{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "assistant",
  "main": "worker.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Settings live as Worker secrets (`npm run secrets`); keep any added in the
  // dashboard too, so a deploy ships code without clearing them.
  "keep_vars": true,
  // The built React client (`npm run build`). Only /api/* reaches the Worker;
  // other paths are static files, with the app shell for client-side routes.
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": { "bindings": [{ "name": "HOUSEHOLD", "class_name": "Household" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Household"] }],
  "observability": { "enabled": false },
}
