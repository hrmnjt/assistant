APP_ORIGIN=http://localhost:8787
OWNER_PASSWORD=replace-with-long-owner-password
PARTNER_PASSWORD=replace-with-long-partner-password
# Optional: iCloud app-specific credentials, never the primary Apple password.
# ICLOUD_USERNAME=
# ICLOUD_APP_PASSWORD=
# ICLOUD_CALENDAR_NAME=Household
# ICLOUD_CALENDAR_URL=
# Optional: stable VAPID keypair, generated with npm run cloudflare:configure.
# PUSH_CONTACT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Hosted ChatGPT eligibility must be established before enabling these:
# MODEL_MODE=chatgpt
# ALLOW_HOSTED_CHATGPT=true
# CHATGPT_MODEL_ID=
# CHATGPT_CREDENTIAL_JSON=
